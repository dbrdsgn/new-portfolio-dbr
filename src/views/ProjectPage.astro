---
// Страница кейса: название, текст, галерея (все картинки и видео из папки кейса), следующий проект.
// Каркас на стандартных стилях IDS — дизайн страницы кейса ещё предстоит.
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { categoryLabel } from '../data/categories';
import { localizeProject, getNextProject, renderLocalized, getGallery } from '../lib/projects';

interface Props {
  lang: Lang;
  entry: CollectionEntry<'projects'>;
}

const { lang, entry } = Astro.props;
const t = useTranslations(lang);
const project = await localizeProject(entry, lang);
const next = await getNextProject(entry, lang);
const { Content } = await renderLocalized(project);
const gallery = getGallery(entry.id);
---

<BaseLayout title={`${project.title} — ${t('site.name')}`} description={project.description} ogImage={entry.data.cover}>
  <article class="ids__wrapper XL">
    <div class="ids__space L"></div>
    <h1 class="S">{project.title}</h1>
    <p class="project-meta">{categoryLabel(entry.data.category, lang)}, {entry.data.year}</p>
    <div class="ids__space S"></div>
    <div class="ids__text-width">
      <Content />
    </div>
    <div class="ids__space M"></div>

    <div class="project-gallery">
      {
        gallery.map((item, i) =>
          item.kind === 'image' ? (
            <figure>
              <Image
                src={item.image}
                alt=""
                widths={[800, 1400, 2000, 2400]}
                sizes="100vw"
                format="avif"
                loading={i === 0 ? 'eager' : 'lazy'}
              />
            </figure>
          ) : (
            <figure>
              <video src={item.src} autoplay muted loop playsinline preload="metadata" />
            </figure>
          ),
        )
      }
    </div>

    {
      next && (
        <>
          <div class="ids__space L"></div>
          <a class="project-next" href={next.url}>
            <span class="project-meta">{t('project.next')}</span>
            <span class="project-next__title">{next.title}</span>
          </a>
        </>
      )
    }
    <div class="ids__space XL"></div>
  </article>
</BaseLayout>
