---
// Страница статьи: название, дата и первоисточник, текст с картинками и подписями.
// Каркас на стандартных стилях IDS — дизайн страницы статьи ещё предстоит.
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import type { Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';
import { localizeArticle, renderArticle, articleDate } from '../lib/articles';

interface Props {
  lang: Lang;
  entry: CollectionEntry<'articles'>;
}

const { lang, entry } = Astro.props;
const t = useTranslations(lang);
const article = await localizeArticle(entry, lang);
const { Content } = await renderArticle(article);
const source = entry.data.source;
---

<BaseLayout
  title={`${article.title} — ${t('site.name')}`}
  description={article.description}
  ogTitle={article.title}
  ogImage={entry.data.cover}
>
  <article class="ids__wrapper">
    <div class="ids__space L"></div>
    <h1 class="S">{article.title}</h1>
    <p class="project-meta">
      <time datetime={entry.data.date.toISOString().slice(0, 10)}>{articleDate(entry, lang)}</time>
      {
        source && (
          <>
            {' · '}
            <a href={source} target="_blank" rel="noopener">
              {t('article.source')} {new URL(source).hostname.replace(/^www\./, '')}
            </a>
          </>
        )
      }
    </p>
    <div class="ids__space S"></div>
    <div class="article-body">
      <Content />
    </div>
    <div class="ids__space XL"></div>
  </article>
</BaseLayout>
