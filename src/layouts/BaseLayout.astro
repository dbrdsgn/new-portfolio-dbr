---
// Общий каркас всех страниц: <head>, шапка, подвал.
// IDS: tokens → settings → reset → page-composition → components, потом стили сайта
import '../styles/ids/css/tokens/palette.css';
import '../styles/ids/css/tokens/colors.css';
import '../styles/ids/css/tokens/scales.css';
import '../styles/ids/css/settings.css';
import '../styles/ids/css/reset.css';
import '../styles/ids/css/page-composition/layout.css';
import '../styles/ids/css/components/ids.css';
import '../styles/site.css';

import cyrillicFont from '../styles/ids/fonts/geologica-cyrillic.woff2?url';
import latinFont from '../styles/ids/fonts/geologica-latin.woff2?url';
import { getImage } from 'astro:assets';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getLangFromUrl, useTranslations, switchLangPath } from '../i18n/utils';

interface Props {
  title?: string;
  description?: string;
  /** Картинка для превью ссылки (Open Graph); у кейса — обложка */
  ogImage?: ImageMetadata;
}

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { title = t('site.title'), description = t('site.description'), ogImage } = Astro.props;

// Предпросмотр на GitHub Pages не должен попадать в поисковики вместо боевого домена
const isPreview = import.meta.env.PUBLIC_PREVIEW === 'true';

const og = ogImage ? await getImage({ src: ogImage, width: 1200, format: 'jpg' }) : undefined;
const ogUrl = og ? new URL(og.src, Astro.site) : undefined;

const canonical = new URL(Astro.url.pathname, Astro.site);
const alternateRu = new URL(switchLangPath(Astro.url, 'ru'), Astro.site);
const alternateEn = new URL(switchLangPath(Astro.url, 'en'), Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {isPreview && <meta name="robots" content="noindex, nofollow" />}

    <!-- Языковые версии страницы — для поисковиков -->
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="ru" href={alternateRu} />
    <link rel="alternate" hreflang="en" href={alternateEn} />
    <link rel="alternate" hreflang="x-default" href={alternateRu} />

    <!-- Превью ссылок (Open Graph) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t('site.name')} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'ru' ? 'ru_RU' : 'en_US'} />
    {ogUrl && <meta property="og:image" content={ogUrl} />}
    <meta name="twitter:card" content={ogUrl ? 'summary_large_image' : 'summary'} />

    <link rel="preload" href={lang === 'ru' ? cyrillicFont : latinFont} as="font" type="font/woff2" crossorigin />

    <!-- Тема: по системной настройке. До загрузки стилей, чтобы не мигало -->
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var dark = matchMedia('(prefers-color-scheme: dark)');
        function apply() { root.classList.toggle('dark', dark.matches); }
        apply();
        dark.addEventListener('change', apply);
      })();
    </script>
  </head>

  <body class="ids">
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
