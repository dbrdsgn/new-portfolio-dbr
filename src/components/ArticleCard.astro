---
// Карточка статьи: сгенерированная обложка + название. Стоит на «Знаниях» и, если она есть
// в документе «Порядок на главной.md», на главной. Вёрстка и стили те же, что у карточки проекта.
import NoteCover from './NoteCover.astro';
import { articleCoverSeed, type LocalizedArticle } from '../lib/articles';

interface Props {
  article: LocalizedArticle;
}

const { article } = Astro.props;
---

<a class="ids__sequence-item project-card" href={article.url}>
  <div class="ids__rounded project-card__cover">
    <NoteCover seed={articleCoverSeed(article.entry)} />
  </div>
  <h2 class="project-card__title"><span>{article.title}</span></h2>
</a>
