---
// Строка тегов на странице «Проекты»: «Все», затем все теги — и те, где проектов пока нет.
// Фильтрует сетку скрипт страницы — по data-tag.
import type { Lang } from '../i18n/ui';
import { useTranslations, localePath } from '../i18n/utils';
import { tags } from '../data/categories';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const projectsPage = localePath(lang, 'projects');

const items = [
  { slug: 'all', label: t('tags.all'), href: projectsPage },
  ...tags.map((tag) => ({ slug: tag.slug, label: tag.label[lang], href: `${projectsPage}?tag=${tag.slug}` })),
];
---

<nav aria-label={t('tags.label')}>
  <ul class="project-tags">
    {
      items.map((item) => (
        <li>
          <a href={item.href} data-tag={item.slug} aria-current={item.slug === 'all' ? 'true' : undefined}>
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
