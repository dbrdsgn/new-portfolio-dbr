---
// Шапка: слева имя (на главную), «Проекты», «Знания»; справа «Почта» и язык.
// Не закреплена, уезжает при прокрутке. «Почта» по клику копирует адрес,
// без скриптов или без доступа к буферу открывает почтовую программу.
import { languages, email, type Lang } from '../i18n/ui';
import { getLangFromUrl, useTranslations, localePath, switchLangPath } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const sections = [
  { href: localePath(lang), label: t('site.name') },
  { href: localePath(lang, 'projects'), label: t('nav.projects') },
  { href: localePath(lang, 'knowledge'), label: t('nav.knowledge') },
];
// Только ссылка на другой язык: на русской версии «En», на английской «Ru»
const other = (Object.keys(languages) as Lang[]).find((l) => l !== lang)!;
---

<header class="ids__wrapper XL site-bar">
  <nav class="site-bar__nav" aria-label={t('nav.label')}>
    {sections.map((s) => <a href={s.href}>{s.label}</a>)}
  </nav>

  <div class="site-bar__end">
    <a
      href={`mailto:${email}`}
      class="site-email"
      data-copy-email={email}
      data-copied={t('contact.copied')}
      title={t('contact.copy')}>{t('contact.email')}</a
    >
    <span class="visually-hidden" aria-live="polite" data-copy-status></span>
    <a class="site-lang" href={switchLangPath(Astro.url, other)} hreflang={other} lang={other} data-lang-link>
      {languages[other]}
    </a>
  </div>
</header>

<script>
  // Копирование адреса почты. Подпись на секунду меняется на «Скопировано»
  const link = document.querySelector<HTMLAnchorElement>('[data-copy-email]');
  const status = document.querySelector<HTMLElement>('[data-copy-status]');
  if (link && navigator.clipboard) {
    const label = link.textContent ?? '';
    const copied = link.dataset.copied ?? '';
    let timer: ReturnType<typeof setTimeout>;
    link.addEventListener('click', (e) => {
      e.preventDefault();
      navigator.clipboard.writeText(link.dataset.copyEmail ?? '').then(
        () => {
          link.textContent = copied;
          if (status) status.textContent = copied;
          clearTimeout(timer);
          timer = setTimeout(() => {
            link.textContent = label;
            if (status) status.textContent = '';
          }, 1500);
        },
        () => {
          location.href = link.href;
        },
      );
    });
  }
</script>
